# Copie para .env e ajuste. Todos os valores abaixo já são o padrão do compose.

# ── Réplica da VM de produção (2 OCPU ARM · 3GHz · 12GB) ────────────────────
# CPUSET_SUT: cores COMPARTILHADOS entre nginx, JVM e Postgres. É assim que a VM
# funciona — três processos disputando 2 cores, sem cota separada.
CPUSET_SUT=0,1
# CPUSET_LOAD: onde o k6 roda. Precisa ser disjunto do CPUSET_SUT, senão o gerador
# de carga compete com o alvo e o teste mede a sua máquina.
CPUSET_LOAD=2-15

# Memória: soma 9.25GB, dentro dos 12GB da VM. O que sobra é a folga que a VM também
# tem — SO, page cache e picos. mem_limit é teto, não reserva: dar mais ao Postgres
# não tira nada de ninguém, só permite que o page cache dele cresça como cresce lá.
# API_MEM cobre heap 2g + metaspace 384m + code cache + threads ≈ 3g de RSS.
API_MEM=4g
PG_MEM=5g
NGINX_MEM=256m
PG_SHM=256m

# JVM: as mesmas flags do pm2 em produção (-XX:+UseG1GC -XX:+UseCompactObjectHeaders
# -Xms2g -Xmx2g -XX:+AlwaysPreTouch -XX:MaxMetaspaceSize=384m, heap dump e JFR).
# Xms=Xmx com AlwaysPreTouch: o heap inteiro é tocado no boot, então o container já
# sobe com ~2.3GB de RSS e o GC nunca cresce/encolhe o heap durante a medição.
JAVA_XMX=2g
JAVA_XMS=2g
JAVA_MAX_METASPACE=384m
# ActiveProcessorCount não existe em produção (a VM tem 2 cores de verdade); aqui é
# preciso porque a JVM conta os cores do host, não os do cpuset.
JAVA_PROCESSORS=2
# JFR ligado como em produção (custo real de ~1%). Deixe JFR_OPTS vazio para desligar.
JFR_OPTS=-XX:StartFlightRecording=name=finax,maxsize=256m,maxage=12h,dumponexit=true,filename=/logs/finax.jfr
JAVA_EXTRA_OPTS=

# ── Banco ───────────────────────────────────────────────────────────────────
DB_NAME=finax
DB_USER=finax
DB_PASSWORD=finax
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=128MB
PG_LOG_MIN_DURATION=1000

# ── API ─────────────────────────────────────────────────────────────────────
# Precisa ser o mesmo do JWT_SECRET abaixo: o k6 assina o token de ativação com ele.
JWT_SECRET=loadtest-secret-token
# Rate limit da aplicação (IpRateLimitFilter + UserRateLimitFilter). Desligado por
# padrão: com um IP só gerando a carga, ligado o teste mede o limitador.
LT_RATE_LIMIT=false
LT_COOKIE_SECURE=true
LT_EMAIL_RETRY_ATTEMPTS=1

# ── nginx ───────────────────────────────────────────────────────────────────
# api.conf = sem limites (padrão) | api-ratelimit.conf = limites de produção
NGINX_SITE=api.conf

# ── Portas expostas no host (só para inspeção manual) ───────────────────────
HTTP_HOST_PORT=58081
HTTPS_HOST_PORT=58443
API_HOST_PORT=58080
PG_HOST_PORT=55432

# ── k6 ──────────────────────────────────────────────────────────────────────
BASE_URL=https://nginx
PROFILE=baseline
# VUS = usuários simultâneos em regime; SIGNUP_RATE = cadastros novos por minuto;
# DURATION = minutos de patamar; WRITE_RATIO = fatia de iterações que escrevem.
VUS=40
SIGNUP_RATE=10
DURATION=8
WRITE_RATIO=0.15
# Histórico criado no cadastro: 50 lançamentos em cada um dos últimos 3 meses (150 no
# total). Cada usuário novo custa ~150 POSTs — ver README, seção "Volume por usuário".
RELEASES_PER_MONTH=50
HISTORY_MONTHS=3
THINK_TIME_MIN=0.5
THINK_TIME_MAX=2.5

# ── Concorrência máxima (make seed + make capacity) ─────────────────────────
# SEED_USERS: usuários pré-criados por `make seed`, com e-mail previsível
# (seed-1@..., seed-2@...). Precisa ser >= o maior degrau de CAPACITY_STEPS, senão
# os VUs excedentes compartilham o mesmo usuário e o cache da API fica otimista.
# Custo: cada um são ~155 requisições, então 800 usuários ≈ 124 mil escritas (~5 min).
SEED_USERS=800
SEED_VUS=20
# Degraus de VUs do perfil `capacity`. Suba o topo se o joelho não aparecer.
CAPACITY_STEPS=100,200,400,800
CAPACITY_STEP_MINUTES=2
